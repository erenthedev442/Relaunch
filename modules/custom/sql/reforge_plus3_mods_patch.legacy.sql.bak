-- ============================================================
-- reforge_plus3_mods_patch.sql
--
-- One-item patch for agoge_mufflers_+3 (WAR Relic hands) which
-- the main generator skipped because it had 3 pre-existing token
-- mods (WAR JA-bonus mods 903/904/956). Those tokens are layered
-- ON TOP of the standard +3 stat block, which was missing.
--
-- Uses INSERT IGNORE so the existing token values (mod 956=15
-- specifically — which was hand-tuned higher than the +2 value)
-- are PRESERVED. Only mods not already present on the +3 are
-- added. Idempotent.
-- ============================================================

-- Relic+3 WAR hands  agoge_mufflers_+3 (derived from agoge_mufflers_+2)
INSERT IGNORE INTO `item_mods` VALUES (23532, 1, 119);
INSERT IGNORE INTO `item_mods` VALUES (23532, 2, 70);
