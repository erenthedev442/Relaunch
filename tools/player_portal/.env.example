# Player Portal config. Copy this file to `.env` and fill it in.
# NEVER commit .env -- it holds secrets (see .gitignore).

# --- Database: a DEDICATED READ-ONLY user. Do NOT use xiuser. ---
# Create it with the SQL in README.md ("Step 1"), or on the OVH VPS with
# sql/portal_setup_windows.sql (see deploy/DEPLOY_WINDOWS.md).
# Co-located with the DB (the VPS): keep 127.0.0.1. PORTAL_DB_NAME=xi_relaunch there.
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=3306
PORTAL_DB_USER=portal_ro
PORTAL_DB_PASS=CHANGE_ME_strong_db_password
PORTAL_DB_NAME=xidb

# --- Session signing secret (HS256 JWT). Keep it secret; rotating it logs everyone out. ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_JWT_SECRET=CHANGE_ME_long_random_secret_at_least_32_chars
PORTAL_JWT_TTL_HOURS=12

# --- Session cookie ---
PORTAL_COOKIE_NAME=portal_session
# true in production (HTTPS). Set false ONLY for local http:// testing.
PORTAL_COOKIE_SECURE=true
# 'lax'  -> API and site share a domain (recommended; serve the API under /api via the tunnel).
# 'none' -> API is on a different site than the frontend (requires PORTAL_COOKIE_SECURE=true).
PORTAL_COOKIE_SAMESITE=lax

# --- CORS: only if the frontend is a DIFFERENT origin than the API. ---
# Comma-separated list, e.g. https://legendary-ffxi.pages.dev
# Leave empty when serving same-origin (recommended).
PORTAL_CORS_ORIGINS=
