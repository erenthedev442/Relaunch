-- ============================================================
-- zz_reforge_plus3_outliers.sql
--
-- 5 Reforge +3 items that the BG-Wiki generator skipped because
-- they had pre-existing token mods (job-specific JA bonuses) which
-- made the gen's 'is naked' check treat them as already populated.
-- Without this file these items ship with ONLY their tokens and no
-- standard stat block.
--
-- Strategy: derive each +3 stats from its +2 sibling using the
-- PLUS3_STEP table (median delta across the user's 110 healthy
-- AF+3 vs AF+2 pairs).
--
-- Filename prefix 'zz_' ensures we load AFTER /sql/item_mods.sql
-- (which does DROP TABLE on every full update); INSERT IGNORE
-- preserves existing tokens AND any future BG-Wiki data — if
-- BG-Wiki ever populates one of these items, its row wins.
-- ============================================================

-- Relic+3  COR   head  lanun_tricorne_+3 (derived from lanun_tricorne_+2)
