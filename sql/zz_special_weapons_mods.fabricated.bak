-- ============================================================
-- zz_special_weapons_mods.sql
--
-- 6 named weapons in gear_progression_catalog.lua that ship with
-- base DMG/Delay but empty/sparse item_mods. Filled using the same
-- per-skill VOLUSPA_TEMPLATE as the Tokko/Voluspa line, scaled up
-- by cost-ratio (15 marks = 1.00x baseline, 30 marks = 1.50x).
--
-- INSERT IGNORE preserves any pre-existing partial mods
-- (Twilight Knife has 2, Compensator has 1).
-- ============================================================

